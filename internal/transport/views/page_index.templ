package views

/*
 * Template que se utiliza para mostrar la página de inicio.
 */
templ IndexPage() {
    @Layout("Inicio") {
        <div class="home">
            <div class="card">
                <h2>¡Bienvenido, Joven Peliculero!</h2>
                <p>
                    Esta página Web tiene una lista de películas para que los usuarios
                    rankeen y den sus opiniones. También pueden filtrar por catálogo ver
                    el portal de comentarios para conocer las opiniones más relevantes del
                    resto de usuarios. Se puede consultar, además, la información de las
                    películas que desee.
                </p>
            </div>
        </div>
    }
}