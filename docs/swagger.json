    "definitions": {
        "api.JsonError": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "error message"
                }
            }
        },
        "service.AddCategoryInput": {
            "type": "object",
            "required": [
                "genre_id"
            ],
            "properties": {
                "genre_id": {
                    "type": "integer"
                }
            }
        },
        "service.AddGenreInput": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "name": {
                    "type": "string"
                }
            }
        },
        "service.AddMovieInput": {
            "type": "object",
            "required": [
                "duration_minutes",
                "released_at",
                "synopsis",
                "title"
            ],
            "properties": {
                "duration_minutes": {
                    "type": "integer",
                    "minimum": 1
                },
                "poster_url": {
                    "type": "string"
                },
                "released_at": {
                    "type": "string"
                },
                "synopsis": {
                    "type": "string",
                    "maxLength": 5000
                },
                "title": {
                    "type": "string",
                    "maxLength": 255
                }
            }
        },
        "service.Genre": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "name": {
                    "type": "string",
                    "example": "terror"
                }
            }
        },
        "service.Movie": {
            "type": "object",
            "properties": {
                "duration_minutes": {
                    "type": "integer",
                    "example": 255
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "poster_url": {
                    "type": "string",
                    "example": "https://www.amazon.nl/Lord-Strings-J-Khan/dp/B000BU9TAQ"
                },
                "released_at": {
                    "type": "string",
                    "example": "2025-10-30T00:00:00Z"
                },
                "synopsis": {
                    "type": "string",
